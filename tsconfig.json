{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    /* Dead bindings are how the reader's per-ayah save lock went missing while still passing
       every check: `eslint-config-next` does not enable `no-unused-vars` and the build ignored
       lint. These two options make the compiler the enforcement point. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  /* "isolate" is a stale duplicate snapshot of this project; it is git-ignored and
     must not be type-checked or bundled alongside the real sources. */
  "exclude": ["node_modules", "isolate", ".next", "out"]
}
